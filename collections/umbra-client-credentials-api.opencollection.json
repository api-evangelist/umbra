{
  "opencollection": "1.0.0",
  "info": {
    "name": "Admin Client Credentials API",
    "version": "3.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Client Credentials",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Token",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.canopy.umbra.space/admin/m2m/token"
          },
          "docs": "Retrieve the M2M client_id and client_secret for your Organization"
        },
        {
          "info": {
            "name": "Create Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.canopy.umbra.space/admin/m2m/token"
          },
          "docs": "Create the M2M Application for your Organization"
        },
        {
          "info": {
            "name": "Rotate Token",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.canopy.umbra.space/admin/m2m/token"
          },
          "docs": "Rotate the M2M client_id and client_secret for your Organization"
        },
        {
          "info": {
            "name": "Delete Token",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.canopy.umbra.space/admin/m2m/token"
          },
          "docs": "Delete the M2M Application for your Organization"
        }
      ]
    }
  ],
  "bundled": true
}