{
  "opencollection": "1.0.0",
  "info": {
    "name": "Umbra Collections API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Collections",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a single STAC Item",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.canopy.umbra.space/v2/stac/collections/:collection_id/items/:item_id",
            "params": [
              {
                "name": "collection_id",
                "value": "",
                "type": "path",
                "description": "Collection ID"
              },
              {
                "name": "item_id",
                "value": "",
                "type": "path",
                "description": "Item ID"
              }
            ]
          },
          "docs": "Get information about one STAC item by its specific item ID and collection ID. STAC item assets include signed URLs."
        },
        {
          "info": {
            "name": "List all Collections",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.canopy.umbra.space/v2/stac/collections"
          },
          "docs": "Get a list of all Collections."
        },
        {
          "info": {
            "name": "Get a single Collection",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.canopy.umbra.space/v2/stac/collections/:collection_id",
            "params": [
              {
                "name": "collection_id",
                "value": "",
                "type": "path",
                "description": "Collection ID"
              }
            ]
          },
          "docs": "Get information about a specific Collection."
        },
        {
          "info": {
            "name": "List all STAC Items in a Collection",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.canopy.umbra.space/v2/stac/collections/:collection_id/items",
            "params": [
              {
                "name": "collection_id",
                "value": "",
                "type": "path",
                "description": "Collection ID"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Limits the number of results that are included in each page of the response (capped to 10_000)."
              },
              {
                "name": "bbox",
                "value": "",
                "type": "query",
                "description": "Only return items intersecting this bounding box. Mutually exclusive with **intersects**."
              },
              {
                "name": "datetime",
                "value": "",
                "type": "query",
                "description": "Only return items that have a temporal property that intersects this value.\n\nEither a date-time or an interval, open or closed. Date and time expressions adhere to RFC 3339. Open intervals are expressed using double-dots."
              }
            ]
          },
          "docs": "Get a list of all STAC Items in a Collection."
        }
      ]
    }
  ],
  "bundled": true
}